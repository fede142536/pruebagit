<Project Sdk="Microsoft.NET.Sdk">

  <!-- Núcleo en C# puro: sin dependencias de Unity ni paquetes NuGet (ver Docs/DECISIONS.md D-02). -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <!-- Unity 6 soporta C# 9. -->
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>Football.Core</AssemblyName>
    <RootNamespace>Football.Core</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Convención del proyecto: todo miembro público lleva comentario XML. -->
    <WarningsAsErrors>CS1591</WarningsAsErrors>
    <!-- Sin el commit en la versión: la DLL solo cambia si cambia el código (CI comprueba que la versionada esté al día). -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Deterministic>true</Deterministic>
    <!-- Sin símbolos de depuración en la DLL: así no lleva rutas de la máquina que compila. -->
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Football.Core.Tests" />
  </ItemGroup>

</Project>
